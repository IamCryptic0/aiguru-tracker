# Copy to .env.local for local dev, and set these in Vercel → Project → Settings → Environment Variables.

# Team login password. If unset, the app runs in OPEN mode (no login required).
APP_PASSWORD=change-me

# Secret used to sign session cookies. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=replace-with-a-long-random-string

# Google Chat incoming webhook URL (includes key & token). Keep secret.
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=...&token=...

# Provisioned automatically when you connect a Vercel Blob store to the project.
# BLOB_READ_WRITE_TOKEN=
